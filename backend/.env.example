# ── AcadTrack Facilitator API — environment ─────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env.

# Async SQLAlchemy URL to your Supabase Postgres.
# In Supabase: Project Settings → Database → Connection string → "Connection
# pooling" (Transaction). Take the URI and change the scheme to
# `postgresql+asyncpg`. Example (pooler, IPv4-friendly, port 6543):
#   postgresql+asyncpg://postgres.njzvuwkepaasnsvuujgx:YOUR_DB_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# Or the direct connection (port 5432):
#   postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.njzvuwkepaasnsvuujgx.supabase.co:5432/postgres
DATABASE_URL=

# Secret used to sign facilitator session JWTs. Use a long random string.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# (optional) token lifetime in minutes; default is 30 days
# JWT_EXPIRE_MINUTES=43200

# Allowed frontend origins (comma-separated). Add your deployed web URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI / Vision (optional — the photo-scan feature needs at least one) ───────
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional pin overrides:
# GEMINI_VISION_MODEL=
# GROQ_VISION_MODEL=

# ── Web Push / VAPID (optional) ─────────────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@acadtrack.app
